    ],
  },
  {
    id: "progress",
    label: "Progresso",
    items: [
      { id: "ranking", icon: "ranking", label: "Ranking" },
      { id: "certificado", icon: "certificate", label: "Certificados" },
      { id: "certificacoes_vulcan", icon: "shield", label: "Prova oficial" },
      { id: "planos", icon: "plans", label: "Planos" },
